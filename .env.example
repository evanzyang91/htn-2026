TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Optional: one-shot goal refinement in the inspector (defaults to TEXT_MODEL).
REFINE_MODEL=
# Optional: comma-separated models offered in the inspector's refinement select.
REFINE_MODELS=
# Optional: reasoning effort for refinement — low, medium, or high.
REFINE_EFFORT=
